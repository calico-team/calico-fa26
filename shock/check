#!/usr/bin/bash

# Exit on error
# set -e

if ! [[ -v PY_CMD ]]; then PY_CMD=python; fi
if ! [[ -v JAVA_CMD ]]; then JAVA_CMD=java; fi
if ! [[ -v CPP_CC ]]; then CPP_CC=g++; fi
TIME_LIMIT=0  # 0 = no limit, overridden by -t flag
FAIL_FAST=0   # 1 = stop on first error

compile() {
	if [[ "$TARGET" == *cpp ]]; then
		$CPP_CC -O2 "$TARGET" -o bin
	elif [[ "$TARGET" == *java ]]; then
		mkdir -p java_bin
		javac -d java_bin "$TARGET"
	fi
}
cleanup() {
	if [[ "$TARGET" == *cpp ]]; then
		rm -f bin
	elif [[ "$TARGET" == *java ]]; then
		rm -rf java_bin
	fi
}
run() {
	echo "Running case $1"
	local start end elapsed

	if [[ "$TARGET" == *py ]]; then
		start=$(date +%s%3N)
		if [[ $TIME_LIMIT -gt 0 ]]; then
			output=$(timeout $TIME_LIMIT $PY_CMD "$TARGET" < "$1.in" 2>/dev/null)
		else
			output=$($PY_CMD "$TARGET" < "$1.in" 2>/dev/null)
		fi
		local exit_code=$?
		end=$(date +%s%3N)
		found=true
	elif [[ "$TARGET" == *java ]]; then
		start=$(date +%s%3N)
		if [[ $TIME_LIMIT -gt 0 ]]; then
			output=$(timeout $TIME_LIMIT $JAVA_CMD -cp java_bin Solution < "$1.in" 2>/dev/null)
		else
			output=$($JAVA_CMD -cp java_bin Solution < "$1.in" 2>/dev/null)
		fi
		local exit_code=$?
		end=$(date +%s%3N)
		found=true
	elif [[ "$TARGET" == *cpp ]]; then
		start=$(date +%s%3N)
		if [[ $TIME_LIMIT -gt 0 ]]; then
			output=$(timeout $TIME_LIMIT ./bin < "$1.in" 2>/dev/null)
		else
			output=$(./bin < "$1.in" 2>/dev/null)
		fi
		local exit_code=$?
		end=$(date +%s%3N)
		found=true
	else
		echo "Unrecognized solution format: $TARGET";
	fi

	if [[ $found == "true" ]]; then
		elapsed=$(( end - start ))
		local time_str="${elapsed}ms"

		# Check for TLE: process killed by timeout, or elapsed time exceeded limit.
		if [[ $exit_code -eq 124 ]] || [[ $TIME_LIMIT -gt 0 && $elapsed -gt $(( TIME_LIMIT * 1000 )) ]]; then
			echo "  TLE! (>${TIME_LIMIT}s) [${time_str}]"
			return 1
		fi

		# Diff against expected answer
		local diff_result=$(echo "$output" | diff -Z -B "$1.ans" -)
		if [[ $diff_result == "" ]]; then
			echo "  Passed! [${time_str}]"
		else
			echo "$diff_result"
			echo "  Failed! [${time_str}]"
			exit 1
		fi
	fi
}

run_multi() {
	for tname in "$@"; do
		run "${tname%.*}"
		if [[ $? -ne 0 && $FAIL_FAST -eq 1 ]]; then
			echo "  Stopping early (--fail-fast)"
			exit 1
		fi
	done
}

usage() {
	cat <<EOF
Solution checking utility.

Usage: ./check [options] <target> [--] [<test-case-in>...]

Example:
  # Run all tests with add.java
    ./check submissions/accepted/add.java
  # Run the secret_00_main_small test
    ./check submissions/accepted/add.cpp data/secret/secret_00_main_small.in
  # Run all secret main tests
    ./check submissions/accepted/add.py data/secret/secret_*_main*
  # Run with specific python command (use this if python command not found)
    PY_CMD=python3 ./check submissions/accepted/add.py
  # Run with specific java command
    JAVA_CMD=/usr/lib/jvm/java-21-openjdk/bin/java ./check submissions/accepted/caliconstruction.java
  # Run with a time limit (seconds)
    ./check -t 4 submissions/accepted/add.py

Options:
  -f, --fail-fast  stop on first error (WA/TLE)
  -q, --quiet      minimize output
  -v, --verbose    increase verbosity
  -h, --help       display this help message and exit
EOF
}

# getopts is another way to parse argument
while [[ $# -gt 0 ]]; do
	case $1 in
		-v|--verbose)
			(( ++verbose )) ;;
		-q|--quiet)
			QUIET=1 ;;
		-t|--time-limit)
			shift
			TIME_LIMIT="$1" ;;
		-f|--fail-fast)
			FAIL_FAST=1 ;;
		-h|--help)
			usage
			exit 0 ;;
		--)
			shift
			break 2 ;;
		-*|--*)
			echo "Unknown option $1"
			exit 1
			;;
		*)
			if [[ -v TARGET ]]; then
				TEST_CASE+=("$1")
			else
				TARGET="$1"
			fi
			;;
	esac
	shift
done

if ! [[ -v TARGET ]]; then
	echo "No target give!"
	exit 1
fi
compile
trap cleanup EXIT
if [[ -v test_name ]]; then
	run $test_name;
elif [[ -v TEST_CASE ]]; then
	run_multi ${TEST_CASE[@]}
else
	run_multi data/**/*.in
fi
cleanup
